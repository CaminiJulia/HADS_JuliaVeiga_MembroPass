# Porta da API
PORT=3000

# Conexão com o PostgreSQL local
DATABASE_URL="postgresql://membropass:membropass@localhost:5432/membropass"

# Segredo para assinar os tokens de login (troque em produção)
JWT_SECRET="troque-este-segredo"

# Validade do token de login, em segundos (padrão: 8 horas)
JWT_EXPIRACAO_SEGUNDOS=28800

# Segredo acima: em produção, use um aleatório com 32+ caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# E-mail (recuperação de senha e senha provisória). Sem SMTP_HOST, os e-mails
# só aparecem no log da API. Gmail: ative a verificação em duas etapas e crie
# uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# E-mail na produção (Render gratuito bloqueia SMTP): um Google Apps Script
# na conta do Gmail envia por HTTPS. Veja api/scripts/envio-email.gs.
# Quando preenchido, tem prioridade sobre o SMTP.
EMAIL_APPS_SCRIPT_URL=
EMAIL_APPS_SCRIPT_SEGREDO=
