# Porta da API
PORT=3000

# Conexão com o PostgreSQL local
DATABASE_URL="postgresql://membropass:membropass@localhost:5432/membropass"

# Segredo para assinar os tokens de login (troque em produção)
JWT_SECRET="troque-este-segredo"

# Validade do token de login, em segundos (padrão: 8 horas)
JWT_EXPIRACAO_SEGUNDOS=28800
